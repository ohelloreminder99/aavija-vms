# Handle line endings automatically for files detected as text
# and leave binary files untouched.
* text=auto

# Explicitly set defaults to LF for source files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
