# This file is a template for the environment variables required by the application.
# Copy this file to .env.local and fill in the values for local development.
# In production, these variables should be set in your hosting environment's secret manager.

# ==================================
# PUBLIC VARIABLES (for client-side)
# ==================================
# These variables will be exposed to the browser.
# Prefix with NEXT_PUBLIC_

# Your Razorpay Key ID (public)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Your reCAPTCHA Enterprise Site Key (public) for Firebase App Check
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAACguM8x6iR-jH9LT"


# ===================================
# PRIVATE VARIABLES (for server-side)
# ===================================
# These variables are only accessible on the server and must be kept secret.

# Your Razorpay Key Secret (private)
RAZORPAY_KEY_SECRET=""

# The email address of the first user to sign up who should be granted admin privileges.
# This is a simple way to bootstrap the first admin user.
NEXT_PUBLIC_ADMIN_EMAIL=""

# Supabase Service Role Key (Admin)
SUPABASE_SERVICE_ROLE_KEY=""
